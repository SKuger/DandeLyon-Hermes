# Copy to .env and fill in. Everything here is optional: with no values
# the service runs with an echo provider, an in-memory store and a
# sender that logs instead of calling Meta.

# Meta app secret. When set, every webhook signature is verified.
META_APP_SECRET=
# Token you choose; Meta echoes it back during the subscription handshake.
META_VERIFY_TOKEN=dev-verify-token
# Permanent access token used to send replies.
META_GRAPH_TOKEN=
META_PHONE_NUMBER_ID=
META_PAGE_ID=

# Without a key the bot answers with the scripted tool provider, which
# still runs the full agent loop.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5

# Anthropic does not serve embeddings. Without a Voyage key the knowledge
# base is searched lexically (TF-IDF), which needs no model and no network.
VOYAGE_API_KEY=
# Markdown files indexed at boot.
KNOWLEDGE_DIR=knowledge

# Without a URL, conversation state lives in process memory.
REDIS_URL=
